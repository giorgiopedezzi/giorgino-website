        },
        {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Mi è piaciuta."
                }
              ]
            }
          ]
        },
        {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "E no, non me l'ha detto internet."
                }
              ]
            }
          ]
        }
