        ]
      },
      {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Ma forse puoi lasciare un pezzetto del tuo cuore."
              }
            ]
          }
        ]
      },
      {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Quello vero."
              }
            ]
          }
        ]
      },
      {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Perché sei un essere umano vero."
              }
            ]
          }
        ]
      },
      {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Non uno plausibile."
              }
            ]
          }
        ]
      },
      {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Vero."
              }
            ]
          }
        ]
      }
    ],
    "decadeHeading": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "A quanto pare, ogni dieci anni ho bisogno di una nuova cattiva idea."
