        "text": {
          "type": "doc",
          "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Ho scoperto dopo cosa significasse la formazione Missing Man. Sapevo solo che era l'immagine che volevo."
              }
            ]
          }
          ]
        },
        "presentation": { "scale": "medium" }
      },
      "signoff": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "L'ho fatto a modo mio."
              }
            ]
          }
        ]
      }
    },
